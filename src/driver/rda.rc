#include <windows.h>
#include <ntverp.h>

#define VER_FILETYPE VFT_DRV
#define VER_FILESUBTYPE VFT2_UNKNOWN
#define VER_FILEDESCRIPTION_STR "RDA Raw Disk Access Driver"
#define VER_INTERNALNAME_STR "rda.sys"
#define VER_ORIGINALFILENAME_STR "rda.sys"
#define VER_LANGNEUTRAL

#include "rda_version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION RDA_VERSION_MAJOR, RDA_VERSION_MINOR, 0, 0
PRODUCTVERSION RDA_VERSION_MAJOR, RDA_VERSION_MINOR, 0, 0
FILEFLAGSMASK 0x3FL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT
FILETYPE VER_FILETYPE
FILESUBTYPE VER_FILESUBTYPE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "heicfast / RDA contributors"
            VALUE "FileDescription", VER_FILEDESCRIPTION_STR
            VALUE "FileVersion", RDA_VERSION_FILE_STRING
            VALUE "InternalName", VER_INTERNALNAME_STR
            VALUE "LegalCopyright", "MIT License. Not affiliated with EaseUS."
            VALUE "OriginalFilename", VER_ORIGINALFILENAME_STR
            VALUE "ProductName", "RDA Raw Disk Access Driver"
            VALUE "ProductVersion", RDA_VERSION_FILE_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
