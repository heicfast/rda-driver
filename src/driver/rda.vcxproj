<?xml version="1.0" encoding="utf-8"?>
<!--
  rda.vcxproj - WDM kernel driver project for the RDA driver.

  Toolchain contract:
   - PlatformToolset WindowsKernelModeDriver10.0 (WDK build system)
   - TargetVersion Windows10 (the only supported _NT_TARGET_VERSION in modern
     WDKs; see docs/win7-compat.md)
   - NTDDI_VERSION=0x06010000 (NTDDI_WIN7) pins header gating so ONLY Win7-SP1
     APIs are used; the produced binary must still load on Windows 7 SP1 -
     enforced by tools/verify_pe.py (import allowlist + PE OS fields 6.1).
   - /W4 /WX zero-warning policy; WDK headers silenced via /external:W0.
   - SignMode=Off: artifacts ship unsigned; the release pipeline owns signing.
   - Linker pins the reference PE contract: /osversion:6.1 /subsystem:native.
-->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{8E4B7C2A-19D3-4F6E-9A57-0C1E2D3B4A55}</ProjectGuid>
    <RootNamespace>rda</RootNamespace>
    <ProjectName>rda</ProjectName>
    <!-- Pin the target platform to the NuGet-restored WDK/SDK build so the
         toolset computes tool paths (stampinf et al.) inside the pinned
         package (WDKBinRoot = WdkContentRoot\bin\10.0.26100.0). Without
         this, the machine's installed SDK version leaks in and tools go
         missing (TRK0005). -->
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>True</UseDebugLibraries>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>WDM</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>False</UseDebugLibraries>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>WDM</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <SignMode>Off</SignMode>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>rda</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>_AMD64_;_WIN64;NTDDI_VERSION=0x06010000;_WIN32_WINNT=0x0601;WINVER=0x0601;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <ExceptionHandling>false</ExceptionHandling>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <ControlFlowGuard>false</ControlFlowGuard>
      <AdditionalIncludeDirectories>$(SolutionDir)src\shared\inc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/external:W0 %(AdditionalOptions)</AdditionalOptions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <!-- PE contract parity with the reference drivers: OS version 6.1,
           native subsystem. Verified post-build by tools/verify_pe.py. -->
      <AdditionalOptions>/osversion:6.1 /subsystem:native %(AdditionalOptions)</AdditionalOptions>
      <TreatLinkerWarningAsErrors>true</TreatLinkerWarningAsErrors>
      <!-- wdmsec.lib: IoCreateDeviceSecure (device SDDL). -->
      <AdditionalDependencies>wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="rda_driver.c" />
    <ClCompile Include="rda_registry.c" />
    <ClCompile Include="rda_control.c" />
    <ClCompile Include="rda_target.c" />
    <ClCompile Include="rda_create.c" />
    <ClCompile Include="rda_readwrite.c" />
    <ClCompile Include="rda_ioctl.c" />
    <ClCompile Include="rda_ident.c" />
    <ClCompile Include="rda_session.c" />
    <ClCompile Include="rda_filter.c" />
    <ClCompile Include="rda_util.c" />
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="rda.rc" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="inc\rda_p.h" />
    <ClInclude Include="inc\rda_trace.h" />
    <ClInclude Include="rda_version.h" />
  </ItemGroup>

  <!-- rda.inf ships as static content (no stampinf/Inf2Cat processing in the
       build; the release pipeline stages it verbatim). Keeping it out of the
       Inf item group avoids the WDK INF tooling entirely. -->
  <ItemGroup>
    <None Include="rda.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
